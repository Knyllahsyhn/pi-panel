frigate:
  base_url: https://192.168.30.2:8971
  user: panel
  password_file: /etc/panel/frigate.pass
  tls_verify: false

mqtt:
  host: 192.168.30.2
  port: 1883
  user: panel-kueche
  password_file: /etc/panel/mqtt.pass
  topic_prefix: frigate

anzeige:
  basis_kamera: klingel
  rueckfall_manuell_s: 60
  rueckfall_auto_s: 30
  sperrzeit_auto_s: 120
  # Kameraknoepfe je Seite. Fehlt der Schluessel, stehen alle auf einer Seite
  # und es gibt keine Blaetterpfeile. Bei 480 px Hoehe sind fuenf das Maximum,
  # das sich noch bequem treffen laesst.
  knoepfe_pro_seite: 5

quelle:
  modus: rtsp
  # auto-safe probiert auf dem Pi Dekoder durch, die es dort nicht gibt, und
  # faellt auf Software zurueck. v4l2m2m nutzt den Hardwaredekoder, no erzwingt
  # Software. Vor dem Umstellen messen, v4l2m2m ist nicht auf jedem Pi stabil.
  hwdec: auto-safe
  mjpeg:
    pfad: "/api/{cam}?fps=5&h=480&bbox=0"
  rtsp:
    basis: "rtsp://192.168.30.2:8554"
    suffix: "_sub"

kameras:
  - {name: klingel,   label: "Klingel",    springt: true}
  - {name: haustuer,  label: "Haustür",   springt: true}
  - {name: einfahrt1, label: "Einfahrt 1", springt: false}
  - {name: einfahrt2, label: "Einfahrt 2", springt: false}
  - {name: pergola,   label: "Pergola",    springt: false}
  - {name: garten,    label: "Garten",     springt: false}
  # Platzhalter fuer die drei neuen Kameras. Namen muessen den Kameranamen in
  # Frigate entsprechen, springt bewusst erst nach Entscheidung je Kamera.
  - {name: neu1,      label: "Neu 1",      springt: false}
  - {name: neu2,      label: "Neu 2",      springt: false}
  - {name: neu3,      label: "Neu 3",      springt: false}
