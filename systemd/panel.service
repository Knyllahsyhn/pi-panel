[Unit]
Description=Kamera-Panel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=panel
Group=panel
RuntimeDirectory=panel
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=__ZIEL__
ExecStart=/usr/bin/xinit __ZIEL__/systemd/panel-session.sh -- :0 -nocursor
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
