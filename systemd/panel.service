[Unit]
Description=Kamera-Panel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=panel
Group=panel
# Ohne PAMName legt logind keine Sitzung an, und ohne Sitzung bekommt Xorg
# weder das virtuelle Terminal noch die Eingabe- und DRM-Geraete zugeteilt.
# Symptom waere "parse_vt_settings: Cannot open /dev/tty0 (Permission denied)".
PAMName=login
TTYPath=/dev/tty7
StandardInput=tty
StandardOutput=journal
StandardError=journal
# pam_systemd verschiebt die Prozesse nach session-N.scope, journald ordnet
# die Ausgabe dann dort ein und `journalctl -u panel` zeigt nur systemd-Zeilen.
# Die Kennung reist im Stream-Header mit und bleibt erhalten.
SyslogIdentifier=panel
TTYVTDisallocate=yes
RuntimeDirectory=panel
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=__ZIEL__
# vt7 muss zu TTYPath passen.
ExecStart=/usr/bin/xinit __ZIEL__/systemd/panel-session.sh -- :0 vt7 -nocursor
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
